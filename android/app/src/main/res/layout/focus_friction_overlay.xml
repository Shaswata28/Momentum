<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/friction_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20F1015"
    android:clickable="true"
    android:focusable="true"
    android:padding="28dp">

    <LinearLayout
        android:id="@+id/friction_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/friction_card_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- App Name -->
        <TextView
            android:id="@+id/tv_friction_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:text="Instagram"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Minimal Breathing Pulse Ring -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp">

            <View
                android:id="@+id/view_breathe_ring"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:background="@drawable/friction_circle_bg" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield_vector" />
        </FrameLayout>

        <!-- Breathing Prompt Cue -->
        <TextView
            android:id="@+id/tv_breathe_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.06"
            android:text="Breathe in..."
            android:textColor="#388AF6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Active Task Title -->
        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="Deep Work Session"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Remaining Time -->
        <TextView
            android:id="@+id/tv_remaining_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="24m left"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Primary Action: Close / Stay Focused -->
        <TextView
            android:id="@+id/btn_return_home"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/friction_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Stay Focused"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Secondary Action: Emergency Pass (minimal text row) -->
        <LinearLayout
            android:id="@+id/btn_emergency_pass"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency pass (5m)"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · "
                android:textColor="#475569"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_pass_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 left"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
