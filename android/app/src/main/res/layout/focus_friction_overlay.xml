<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/friction_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090A0F"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/friction_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- 1. Status Badge -->
        <LinearLayout
            android:id="@+id/layout_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/iv_status_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_shield_vector" />

            <TextView
                android:id="@+id/tv_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.06"
                android:text="Focus Shield Active"
                android:textColor="#388AF6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 2. Shield Icon Container -->
        <FrameLayout
            android:id="@+id/layout_shield_container"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/iv_shield_large"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield_vector" />
        </FrameLayout>

        <!-- 3. Blocked App Name -->
        <TextView
            android:id="@+id/tv_friction_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:gravity="center"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:text="CHROME"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 4. Active Task Title -->
        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="Deep Work Session"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 5. Countdown Card -->
        <LinearLayout
            android:id="@+id/layout_countdown_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <!-- Card Header: Hourglass + Time remaining -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_countdown_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_hourglass_vector" />

                <TextView
                    android:id="@+id/tv_countdown_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:letterSpacing="0.04"
                    android:text="Time remaining"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Large Time -->
            <TextView
                android:id="@+id/tv_remaining_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.02"
                android:text="44m left"
                android:textColor="#F8FAFC"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Motivation Cue -->
            <TextView
                android:id="@+id/tv_countdown_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Stay in flow. You're making real progress."
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 6. Primary Button: Stay Focused -->
        <LinearLayout
            android:id="@+id/btn_return_home"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_stay_focused_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check_vector" />

            <TextView
                android:id="@+id/tv_btn_stay_focused"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.04"
                android:text="Stay Focused"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 7. Secondary Button: Emergency Pass -->
        <LinearLayout
            android:id="@+id/btn_emergency_pass"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/iv_emergency_pass_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_bolt_vector" />

            <TextView
                android:id="@+id/tv_emergency_pass_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Use Emergency Pass  · 5 min"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_pass_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tv_pass_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 LEFT"
                    android:textColor="#F59E0B"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
